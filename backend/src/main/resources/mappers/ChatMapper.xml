<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aihealthcoach.chat.mapper.ChatMapper">
    <resultMap id="chatMessage" type="com.aihealthcoach.chat.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="messageColumn">
        id, session_id, role, content, created_at
    </sql>

    <select id="findMessagesByUserId" parameterType="int" resultMap="chatMessage">
        SELECT
            m.role, m.content, m.created_at
        FROM chat_messages m, chat_sessions s
        WHERE s.user_id=#{userId} AND m.session_id=s.id
    </select>
</mapper>