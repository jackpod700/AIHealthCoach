<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aihealthcoach.user.mapper.UserMapper">

    <resultMap id="user" type="com.aihealthcoach.user.entity.User">
        <id column="id" property="id"/>
        <result column="email" property="email"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="role" property="role"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="userProfile" type="com.aihealthcoach.user.entity.UserProfile">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="height_cm" property="heightCm"/>
        <result column="current_weight_kg" property="currentWeightKg"/>
        <result column="target_weight_kg" property="targetWeightKg"/>
        <result column="goal_type" property="goalType"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="oauthAccount" type="com.aihealthcoach.user.entity.OAuthAccount">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="provider" property="provider"/>
        <result column="provider_user_id" property="providerUserId"/>
        <result column="email" property="email"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findUserByEmail" parameterType="string" resultMap="user">
        SELECT
        id,
        email,
        password,
        nickname,
        role,
        created_at,
        updated_at
        FROM users
        WHERE email = #{email}
    </select>

    <select id="findUserById" parameterType="long" resultMap="user">
        SELECT
        id,
        email,
        password,
        nickname,
        role,
        created_at,
        updated_at
        FROM users
        WHERE id = #{id}
    </select>

    <insert id="insertUser"
            parameterType="com.aihealthcoach.user.entity.User"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO users (
        email,
        password,
        nickname,
        created_at,
        updated_at
        )
        VALUES (
        #{email},
        #{password},
        #{nickname},
        NOW(),
        NOW()
        )
    </insert>

    <select id="insertOAuthUser"
            parameterType="com.aihealthcoach.user.entity.User"
            resultType="long"
            affectData="true">
        INSERT INTO users (
        email,
        password,
        nickname,
        created_at,
        updated_at
        )
        VALUES (
        #{email},
        #{password},
        #{nickname},
        NOW(),
        NOW()
        )
        RETURNING id
    </select>

    <insert id="insertUserProfile" parameterType="com.aihealthcoach.user.entity.UserProfile">
        INSERT INTO user_profiles (
        user_id,
        height_cm,
        current_weight_kg,
        target_weight_kg,
        goal_type,
        updated_at
        )
        VALUES (
        #{userId},
        #{heightCm},
        #{currentWeightKg},
        #{targetWeightKg},
        #{goalType},
        NOW()
        )
    </insert>

    <select id="findUserProfileByUserId" parameterType="long" resultMap="userProfile">
        SELECT
        id,
        user_id,
        height_cm,
        current_weight_kg,
        target_weight_kg,
        goal_type,
        updated_at
        FROM user_profiles
        WHERE user_id = #{id}
    </select>

    <update id="updateUserProfile">
        UPDATE user_profiles
        <set>
            <if test="request.heightCm != null">
                height_cm = #{request.heightCm},
            </if>
            <if test="request.currentWeightKg != null">
                current_weight_kg = #{request.currentWeightKg},
            </if>
            <if test="request.targetWeightKg != null">
                target_weight_kg = #{request.targetWeightKg},
            </if>
            <if test="request.goalType != null">
                goal_type = #{request.goalType},
            </if>
            updated_at = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>

    <select id="findOAuthAccount" resultMap="oauthAccount">
        SELECT
        id,
        user_id,
        provider,
        provider_user_id,
        email,
        created_at,
        updated_at
        FROM oauth_accounts
        WHERE provider = #{provider}
        AND provider_user_id = #{providerUserId}
    </select>

    <insert id="insertOAuthAccount"
            parameterType="com.aihealthcoach.user.entity.OAuthAccount"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO oauth_accounts (
        user_id,
        provider,
        provider_user_id,
        email,
        created_at,
        updated_at
        )
        VALUES (
        #{userId},
        #{provider},
        #{providerUserId},
        #{email},
        NOW(),
        NOW()
        )
    </insert>

    <update id="updateUserNickname">
        UPDATE users
        SET
        nickname = #{nickname},
        updated_at = NOW()
        WHERE id = #{userId}
    </update>

</mapper>
