<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aihealthcoach.user.mapper.UserMapper">
    <resultMap id="user" type="com.aihealthcoach.user.entity.User">
        <id column="id" property="id"/>
        <result column="id" property="id"/>
        <result column="email" property="email"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="userProfile" type="com.aihealthcoach.user.entity.UserProfile">
        <id column="id" property="id"/>
        <result column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="height_cm" property="heightCm"/>
        <result column="current_weight_kg" property="currentWeightKg"/>
        <result column="target_weight_kg" property="targetWeightKg"/>
        <result column="goal_type" property="goalType"/>
        <result column="gender" property="gender"/>
        <result column="age" property="age"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap> 

    <select id="findUserByEmail" parameterType="String" resultMap="user">
        SELECT  id, email, password, nickname, created_at, updated_at
        FROM    users
        WHERE   email = #{email}
    </select>

    <insert id="insertUser" parameterType="com.aihealthcoach.user.entity.User">
        INSERT INTO users (email, password, nickname, created_at, updated_at)
        VALUES  (#{email}, #{password}, #{nickname}, NOW(), NOW())
    </insert>

    <insert id="insertUserProfile" parameterType="com.aihealthcoach.user.entity.UserProfile">
        INSERT INTO user_profiles (
            user_id,
            height_cm,
            current_weight_kg,
            target_weight_kg,
            goal_type,
            gender,
            age,
            updated_at
        )
        VALUES (
            #{userId},
            #{heightCm},
            #{currentWeightKg},
            #{targetWeightKg},
            #{goalType},
            #{gender},
            #{age},
            NOW()
        )
    </insert>

    <select id="findUserProfileByUserId" parameterType="Long" resultMap="userProfile">
        SELECT  id, user_id, height_cm, current_weight_kg, target_weight_kg, goal_type, gender, age, updated_at
        FROM    user_profiles
        WHERE   user_id = #{userId}
    </select>

    <update id="updateUserProfile">
        UPDATE user_profiles
        <set>
            <if test="request.heightCm != null">
                height_cm = #{request.heightCm},
            </if>
            <if test="request.currentWeightKg != null">
                current_weight_kg = #{request.currentWeightKg},
            </if>
            <if test="request.targetWeightKg != null">
                target_weight_kg = #{request.targetWeightKg},
            </if>
            <if test="request.goalType != null">
                goal_type = #{request.goalType},
            </if>
            <if test="request.gender != null">
                gender = #{request.gender},
            </if>
            <if test="request.age != null">
                age = #{request.age},
            </if>
            updated_at = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>
</mapper>
